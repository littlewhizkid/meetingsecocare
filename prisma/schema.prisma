generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  password           String
  role               String    @default("USER")
  mustChangePassword Boolean   @default(true)
  bookings           Booking[]
  createdAt          DateTime  @default(now())
}

model Booking {
  id           String    @id @default(cuid())
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  roomId       String
  roomName     String
  /// Half-open interval [startAt, endAt) in UTC. All-day bookings span
  /// civil midnights in the canonical office timezone (Asia/Jakarta).
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean   @default(false)
  bookerName   String
  meetingTitle String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roomId, startAt])
  @@index([roomId, endAt])
  @@index([userId])
  @@index([createdAt])
}

model Room {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  capacity    String    @default("")
  icon        String    @default("🏢")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}